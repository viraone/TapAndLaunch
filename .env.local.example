# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS. Server-only — see src/lib/supabase/admin.ts.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The platform's own domain. Published apps are served at
# {app-slug}.NEXT_PUBLIC_ROOT_DOMAIN. For local dev, "localhost:3000" works
# with subdomains like http://my-app.localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Signs app_members session tokens (src/lib/pwa/member-session.ts). Any long
# random string; generate one with `openssl rand -hex 32`. Rotating it signs
# every published app's members out at once — treat it like any other secret.
MEMBER_SESSION_SECRET=

# --- Phase 4: notifications ---

# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# The public key is read by the browser (subscribing published apps), so it
# is intentionally NEXT_PUBLIC_; the private key signs push messages
# server-side and must never be exposed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI the push services can reach you at if they need to
# (required by the Web Push protocol) — "mailto:you@example.com" or your
# site's https URL.
VAPID_CONTACT=mailto:you@example.com

# Email, via Resend's HTTP API directly (no SDK dependency — see
# src/lib/notifications/email.ts). Leave blank to leave email notifications
# disabled; the send route reports that clearly rather than failing oddly.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@yourdomain.com

# SMS, via Twilio's HTTP API directly (no SDK dependency — see
# src/lib/notifications/sms.ts). Leave blank to leave SMS disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Phase 6: custom domains (Vercel Domains API — see lib/domains/vercel.ts) ---
# Only relevant if this app is actually deployed on Vercel. Leave blank to
# leave custom domains disabled; the domain settings UI reports that
# clearly rather than failing oddly.

# A Vercel API token with access to the project below (Account Settings ->
# Tokens).
VERCEL_API_TOKEN=
# The Vercel project ID this app is deployed as (Project Settings -> General).
VERCEL_PROJECT_ID=
# Only needed if that project belongs to a team, not your personal account.
VERCEL_TEAM_ID=

# --- GasPal block: live gas prices ---
# A Google Cloud API key with Places API (New) enabled and the key restricted
# to that one API. Server-only (no NEXT_PUBLIC_ prefix) — the browser never
# sees it; the published app asks our /gas/nearby route, which caches Google's
# results per ~1-mile cell for an hour so normal use stays inside Google's
# free monthly tier (see lib/gas/). Leave blank to fall back to OpenStreetMap
# station locations with no prices.
GOOGLE_MAPS_API_KEY=
